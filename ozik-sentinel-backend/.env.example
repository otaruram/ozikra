# ==============================================================================
# OZIK-SENTINEL :: Golang Backend Production Environment (Render Deployment)
# Pusat Siber TNI Angkatan Darat (PUSSIBERAD) - Core Infra 2026
# ==============================================================================

# Server Network Configuration (Render automatically assigns PORT)
PORT=8080
GIN_MODE=release

# Dynamic CORS Allowed Origins (Comma-separated URLs: Vercel frontend & Localhost)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,https://your-frontend.vercel.app

# PostgreSQL / Supabase Connection URL (Session / Transaction Pooler or Direct)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your-db-password@db.your-supabase.supabase.co:5432/postgres?sslmode=require

# Military Cryptographic Secret (HMAC-SHA256 Signatures for QR Passports)
SERVER_HMAC_SECRET=generate-a-secure-random-64-character-hex-string
HMAC_SECRET=generate-a-secure-random-64-character-hex-string

# AI Engine Reasoning Modes (GEMINI_CLOUD or OLLAMA_LOCAL)
AI_MODE=GEMINI_CLOUD
AUTH_MODE=GOOGLE_SANDBOX

# Primary AI Gateway: Sumopod AI Gateway (https://ai.sumopod.com)
SUMOPOD_API_KEY=your-sumopod-api-key
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_MODEL=MiniMax-M3.1-Flash-Preview

# Secondary / Direct Cloud AI: Google Gemini API
GEMINI_API_KEY=your-google-gemini-api-key

# Local Air-Gapped Engine (Optional - when AI_MODE=OLLAMA_LOCAL)
OLLAMA_URL=http://localhost:11434
